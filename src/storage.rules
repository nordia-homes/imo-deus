rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /agencies/{agencyId}/privateCommunications/assistant-uploads/{userId}/{uploadId} {
      function session() {
        return firestore.get(/databases/(default)/documents/agencies/$(agencyId)/assistantUploads/$(uploadId)).data;
      }
      function member() {
        return firestore.get(/databases/(default)/documents/users/$(userId)).data;
      }
      allow write: if request.auth != null && request.auth.uid == userId && resource == null && request.resource != null
        && member().agencyId == agencyId && member().role in ['admin', 'agent'] && member().role == session().actorRole
        && session().ownerId == userId && session().status == 'uploading' && session().expiresAt > request.time.toMillis()
        && request.resource.size == session().size && request.resource.size > 0 && request.resource.size <= 500 * 1024 * 1024
        && request.resource.contentType == session().mimeType && session().mimeType in ['video/mp4', 'video/webm', 'video/quicktime']
        && request.resource.metadata.keys().hasOnly(['uploadId']) && request.resource.metadata.uploadId == uploadId;
      allow read: if request.auth != null && request.auth.uid == userId && member().agencyId == agencyId && session().ownerId == userId;
    }

    // Allow users to manage their own files (e.g. profile picture)
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated users to write property images within their agency
    match /agencies/{agencyId}/properties/{propertyId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.agencyId == agencyId;
    }

    // Allow agency admins to manage agent profile images inside their own agency
    match /agencies/{agencyId}/agents/{agentId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.agencyId == agencyId &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Allow agency members to work with contract templates and generated PDFs
    match /agencies/{agencyId}/contracts/{allPaths=**} {
      allow read: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.agencyId == agencyId;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.agencyId == agencyId;
    }

    // Default deny all other writes, allow public reads for things like logos if not under a protected path
    match /{prefix}/{rest=**} {
      allow read: if prefix != 'privateCommunications' && prefix != 'agencies';
      allow write: if false; // Deny by default for security
    }
    match /agencies/{agencyId}/{kind}/{rest=**} {
      allow read: if kind != 'contracts' && kind != 'privateCommunications';
      allow write: if false;
    }
  }
}
